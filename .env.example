# La site key es pública; nunca guardes secretos en este archivo.
TURNSTILE_SITE_KEY=
# Allowlist no secreta, separada por comas. Localhost solo para desarrollo.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
MAX_USERS=10

# Transferencias directas: mantener deshabilitadas hasta configurar CORS de R2 y secretos en el Worker.
DIRECT_R2_TRANSFERS_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY debe configurarse como secreto del Worker; no ponerlo en .env ni versionarlo.
