{
  "name": "vega-drive-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Frontend de Vega Drive con login, registro y sesiones conectados al Worker; las funciones de archivos siguen siendo demostrativas.",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
