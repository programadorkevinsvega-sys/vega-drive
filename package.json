{
  "name": "vega-drive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "node scripts/check-cloudflare-config.mjs",
    "deploy": "wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node scripts/architecture-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "hono": "4.9.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wrangler": "4.40.3"
  }
}
