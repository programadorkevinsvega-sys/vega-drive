{
  "name": "vega-drive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply vega_drive_db --local",
    "db:migrate:production": "wrangler d1 migrations apply vega_drive_db --remote",
    "db:migration:list": "wrangler d1 migrations list vega_drive_db --remote",
    "db:verify:production": "pnpm run db:migration:list && pnpm run db:verify:schema:production",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:production:auth-config": "node scripts/verify-production.mjs --auth-config-only",
    "deploy": "pnpm run deploy:preflight && pnpm run cloudflare:build && pnpm run verify:production:auth-config && pnpm run db:migrate:production && pnpm run db:verify:production && pnpm exec wrangler deploy && pnpm run verify:production",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node scripts/architecture-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test",
    "cloudflare:build": "pnpm run deploy:preflight && pnpm run check && pnpm run frontend:install && pnpm run frontend:check && pnpm audit --audit-level=high && pnpm run frontend:audit && pnpm exec wrangler deploy --dry-run",
    "db:verify:schema:local": "node scripts/verify-d1-schema.mjs --local",
    "db:verify:schema:production": "node scripts/verify-d1-schema.mjs --remote",
    "deploy:preflight": "node scripts/check-cloudflare-config.mjs && pnpm run verify:module-migrations && pnpm run verify:architecture && pnpm run verify:architecture:all",
    "verify:module-migrations": "node scripts/check-module-migrations.mjs",
    "verify:architecture": "node scripts/architecture-check.mjs",
    "verify:module-ownership": "node scripts/architecture/verify-module-ownership.mjs",
    "verify:sql-boundaries": "node scripts/architecture/verify-sql-boundaries.mjs",
    "verify:r2-port-boundary": "node scripts/architecture/verify-r2-port-boundary.mjs",
    "verify:frontend-boundary": "node scripts/architecture/verify-frontend-boundary.mjs",
    "verify:module-extraction": "node scripts/architecture/verify-module-extraction.mjs",
    "verify:r2-privacy": "node scripts/architecture/verify-r2-privacy.mjs",
    "verify:bff-boundary": "node scripts/architecture/verify-bff-boundary.mjs",
    "verify:authenticated-actor": "node scripts/architecture/verify-authenticated-actor.mjs",
    "verify:files-gateway-contract": "node scripts/architecture/verify-files-gateway-contract.mjs",
    "verify:architecture:all": "pnpm run verify:module-migrations && pnpm run verify:architecture && pnpm run verify:module-ownership && pnpm run verify:sql-boundaries && pnpm run verify:r2-port-boundary && pnpm run verify:frontend-boundary && pnpm run verify:module-extraction && pnpm run verify:r2-privacy && pnpm run verify:bff-boundary && pnpm run verify:authenticated-actor && pnpm run verify:files-gateway-contract",
    "frontend:install": "pnpm --dir frontend install --ignore-workspace --frozen-lockfile",
    "frontend:check": "pnpm --dir frontend run check",
    "frontend:audit": "pnpm --dir frontend --ignore-workspace audit --audit-level=high"
  },
  "dependencies": {
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/node": "^26.6.5",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "overrides": {
      "tinypool": "2.1.2",
      "hono@>=4.3.3 <4.12.27": ">=4.12.27",
      "hono@>=4.11.8 <4.12.27": ">=4.12.27",
      "hono@>=4.0.0 <4.12.27": ">=4.12.27",
      "hono@<4.12.34": ">=4.12.34",
      "hono@>=3.8.0 <4.12.34": ">=4.12.34",
      "hono@>=4.7.0 <4.12.34": ">=4.12.34",
      "hono@>=4.12.0 <4.12.34": ">=4.12.34",
      "vitest@>=2.1.0 <4.1.11": ">=4.1.11",
      "@vitest/mocker@>=2.1.0 <4.1.11": ">=4.1.11",
      "hono@<4.13.5": ">=4.13.5",
      "hono@<4.13.7": ">=4.13.7",
      "undici": "7.30.1"
    }
  }
}
