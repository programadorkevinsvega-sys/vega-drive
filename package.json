{
  "name": "vega-drive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "node scripts/check-cloudflare-config.mjs",
    "deploy": "wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node scripts/architecture-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test"
  },
  "dependencies": {
    "hono": "4.12.25"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/node": "^26.6.5",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "3.2.6",
    "wrangler": "4.149.0"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "overrides": {
      "tinypool": "2.1.2"
    }
  }
}
